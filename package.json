{
  "name": "sockbowl-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "buildprod": "ng build --configuration production",
    "test": "ng test",
    "codegen": "bash scripts/gen-packet-types.sh",
    "gen:cast-tokens": "sass src/cast-theme-tokens.scss src/cast-theme-tokens.css --style=compressed --no-source-map",
    "e2e": "playwright test --project=chromium",
    "e2e:auth": "playwright test -c playwright.auth.config.ts",
    "clips": "node scripts/build-clips.mjs",
    "lint": "ng lint",
    "test:headers": "bash scripts/test-headers.sh"
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@stomp/rx-stomp": "^2.4.0",
    "@stomp/stompjs": "^7.3.0",
    "angular-oauth2-oidc": "^22.0.2",
    "rxjs": "~7.8.2",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "^6.0.0",
    "@types/sockjs-client": "^1.5.4",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "graphql": "^17.0.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "quicktype": "^26.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "http-proxy-middleware": "^3.0.7",
    "@babel/core": "^7.29.7"
  }
}
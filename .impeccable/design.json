  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Accent-filled main action (play surfaces, lobby).",
      "html": "<button class=\"ds-btn-primary\">Buzz</button>",
      "css": ".ds-btn-primary{min-height:48px;padding:0 1.75rem;font:700 1rem/1 var(--font-body);background:var(--accent-primary);color:var(--on-accent, #fff);border:0;border-radius:var(--radius-md);cursor:pointer;transition:filter var(--transition-fast)}.ds-btn-primary:hover{filter:brightness(1.06)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent-primary);outline-offset:2px}"
    },
    {
      "name": "Lobby Action",
      "kind": "custom",
      "refersTo": "lobby-action",
      "description": "Full-width row button with icon, label, hint and sliding arrow.",
      "html": "<button class=\"ds-lobby-action\"><span class=\"ds-la-text\"><span class=\"ds-la-label\">Join with a code</span><span class=\"ds-la-hint\">Enter a room’s join code</span></span><svg class=\"ds-la-arrow\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M12 4l-1.4 1.4 5.6 5.6H4v2h12.2l-5.6 5.6L12 20l8-8z\"/></svg></button>",
      "css": ".ds-lobby-action{display:flex;align-items:center;gap:1rem;width:100%;padding:1rem 1.25rem;background:var(--bg-secondary);color:var(--text-primary);border:1px solid var(--border-medium);border-radius:var(--radius-md);text-align:left;cursor:pointer;transition:transform var(--transition-fast),border-color var(--transition-fast)}.ds-la-text{display:flex;flex-direction:column;flex:1}.ds-la-label{font-weight:600}.ds-la-hint{font-size:.85rem;color:var(--text-secondary)}.ds-la-arrow{color:var(--text-muted);transition:transform var(--transition-fast)}.ds-lobby-action:hover{transform:translateY(-2px);border-color:var(--accent-primary)}.ds-lobby-action:hover .ds-la-arrow{transform:translateX(3px);color:var(--accent-primary)}.ds-lobby-action:focus-visible{outline:2px solid var(--accent-primary);outline-offset:2px}"
    },
    {
      "name": "Buzz Button",
      "kind": "custom",
      "refersTo": "buzz-button",
      "description": "Round domed buzzer, the one loud object in play.",
      "html": "<button class=\"ds-buzz\">Buzz</button>",
      "css": ".ds-buzz{width:200px;height:200px;border-radius:50%;border:0;background:var(--error);color:var(--on-error, #fff);font:800 1.75rem/1.15 var(--font-display);letter-spacing:.03em;text-transform:uppercase;box-shadow:0 9px 0 -2px var(--shadow-color),0 14px 26px var(--shadow-color),inset 0 5px 12px rgba(255,255,255,.28),inset 0 -11px 20px rgba(0,0,0,.32);transition:transform 80ms ease,box-shadow 150ms ease;cursor:pointer}.ds-buzz:active{transform:translateY(8px);box-shadow:0 2px 0 -2px var(--shadow-color),0 5px 14px var(--shadow-color),inset 0 3px 10px rgba(0,0,0,.4)}.ds-buzz:focus-visible{outline:3px solid var(--accent-primary);outline-offset:5px}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Surface container for play cards and panels.",
      "html": "<div class=\"ds-card\"><h3 class=\"ds-card-title\">Tossup 3 of 20</h3><p>Card body</p></div>",
      "css": ".ds-card{background:var(--surface);color:var(--text-primary);border:1px solid var(--border-subtle);border-radius:var(--radius-lg);padding:1.5rem;box-shadow:var(--shadow-lg) var(--shadow-color)}.ds-card-title{margin:0 0 1rem;font:700 1.4rem/1.25 var(--font-display)}"
    },
    {
      "name": "Answer Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Inset well text field used in play.",
      "html": "<input class=\"ds-input\" placeholder=\"Your answer\">",
      "css": ".ds-input{min-height:48px;padding:0 1rem;font-size:1.05rem;color:var(--text-primary);background:var(--bg-secondary);border:2px solid var(--border-medium);border-radius:var(--radius-md)}.ds-input::placeholder{color:var(--text-muted)}.ds-input:focus-visible{outline:2px solid var(--accent-primary);outline-offset:2px}"

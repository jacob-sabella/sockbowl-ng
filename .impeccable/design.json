      "description": "Labelled value with status stripe (category, question, answer).",
      "html": "<div class=\"ds-info\"><span class=\"ds-info-label\">Category</span><span class=\"ds-info-value\">Literature</span></div>",
      "css": ".ds-info{padding:.65rem .85rem;border-radius:var(--radius-sm);border-left:3px solid var(--info);background:color-mix(in srgb,var(--info) 10%,transparent)}.ds-info-label{display:block;font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--info)}.ds-info-value{font-size:1rem;font-weight:500;color:var(--text-primary)}"
